{
    "preset": "laravel",
    "rules": {
        "no_superfluous_phpdoc_tags": false,
        "not_operator_with_successor_space": false,
        "phpdoc_separation": { "groups": [["param"], ["return"], ["throws"]] },
        "phpdoc_align": { "align": "left" },
        "concat_space": { "spacing": "one" }
    }
}
